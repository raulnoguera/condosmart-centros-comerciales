# Copia este archivo como .env.local (o define estas variables en el panel del hosting).

# Carpeta de la base de datos y las fotos. En el servidor, ponla fuera de la
# carpeta del código para que un nuevo despliegue no la borre.
# DATA_DIR=/ruta/persistente/atrio

# Primera puesta en marcha en producción: cuenta de la administración que se crea si la
# base está vacía. Después de entrar, cambia la contraseña desde Mi perfil.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Solo para una instalación de prueba: carga los 120 locales y las cuentas de demostración.
# SEED_DEMO=1

# Contraseña de las cuentas de demostración. Si no se define, se genera una al azar.
# Nunca la escribas en el código ni la subas al repositorio.
# DEMO_PASSWORD=
